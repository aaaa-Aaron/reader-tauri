{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    "fs:allow-appdata-meta",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {"path": "$APPDATA/**"},
        {"path": "$APPDATA"},
        {"path": "$HOME/**"}
      ]
    },
    "dialog:default",
    "http:default",
    "shell:default"
  ]
}
